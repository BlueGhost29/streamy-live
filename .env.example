# Streamy Pro Environment Configuration Template
# Copy this file to .env and configure for your local/production environment

# Application Port
PORT=4000

# Environment Mode: development | production
NODE_ENV=development

# Direct-P2P STUN-Assisted Connectivity (No TURN Relay required)
# STUN discovery uses public Google STUN servers (stun.l.google.com:19302)
# Media connections require direct peer-to-peer UDP paths without relay.

